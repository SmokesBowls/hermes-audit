+class _RecordingDirector:
+    def __init__(self, adapter: HermesSessionAdapter) -> None:
+        self.adapter = adapter
+        self.calls = 0
+        self.seen_perception = None
+
+        def provider_call(command: list[str]) -> subprocess.CompletedProcess[str]:
+            return subprocess.CompletedProcess(
+                command,
+                0,
+                f"Warning: Unknown toolsets: {HERMES_EMPTY_TOOLSET}\n"
+                + _valid_provider_response(
+                    "The supplied runtime location is the Cosmic Command Center."
+                )
+                + "\n",
+                f"session_id: {PERSISTED_SESSION_ID}\n",
+            )
+
+        self.adapter.client._run_bounded = provider_call  # type: ignore[method-assign]
+
+    def process_player_input(self, player_input: str, game_state: dict[str, object]):
+        self.calls += 1
+        self.seen_perception = self.adapter.client.pending_perception
+        self.adapter.client.chat([{"role": "user", "content": player_input}])
+        return {"narrative_response": "local fallback must not be published"}
+
